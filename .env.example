# Copy to .env.local and fill in. Never commit real values.

# --- Database ---------------------------------------------------------------
# Supabase: Project → Connect → "Transaction pooler" string (port 6543).
# This is what the app uses at runtime.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Used only by `npm run db:migrate`. Supabase: the "Session pooler" string (port 5432).
# If unset, migrations use DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Connections per server instance. Set to 1 when using `npm run db:dev`.
DATABASE_POOL_MAX=5

# --- Supabase (merchant login + product photo storage) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Optional model overrides (defaults shown).
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_ANALYSIS_MODEL=gpt-5.4

# --- Resend (reward emails; leave the key empty to skip sending) ------------
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend account.
RESEND_FROM="DAP Link <rewards@example.com>"

# --- App --------------------------------------------------------------------
# Not needed on Vercel, which supplies the production domain itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any long random string. IP addresses are hashed with it before storage.
IP_HASH_SALT=
